<UserControl x:Class="Splice.Views.Dialogs.AlertDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             MinWidth="360" MaxWidth="520" FontFamily="Microsoft YaHei UI">
    <Border Padding="22" Background="White" CornerRadius="0">
        <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <materialDesign:PackIcon Kind="AlertCircleOutline" Width="24" Height="24"
                    Foreground="#D04444" Margin="0,0,12,0" />
                <TextBlock Text="{Binding TitleText}" FontWeight="SemiBold" FontSize="17"
                    VerticalAlignment="Center" Foreground="#142B46" />
            </StackPanel>
            <TextBlock Text="{Binding MessageText}" TextWrapping="Wrap" FontSize="13"
                       Foreground="#415C7A" Margin="0,0,0,22" />
            <Button Content="知道了" HorizontalAlignment="Right" MinWidth="96"
                    Style="{StaticResource Splice.FilledButton}"
                    Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}" />
        </StackPanel>
    </Border>
</UserControl>
